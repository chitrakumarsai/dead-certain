{
	"name": "dead-certain",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.9.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit && vitest run --passWithNoTests",
		"check:changed": "biome check --changed --no-errors-on-unmatched . && tsc --noEmit && vitest run --changed --passWithNoTests",
		"test:props": "vitest run .props. --passWithNoTests",
		"build": "pnpm -r --if-present build",
		"e2e": "playwright test",
		"dc": "pnpm -s --filter @dead-certain/kb-tools exec vite build --logLevel warn && node packages/kb-tools/bin/dc.mjs",
		"record:snapshots": "node --experimental-strip-types apps/pre-flight/collectors/record.ts",
		"new-app": "node --experimental-strip-types scripts/new-app.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.7",
		"@dead-certain/engine": "workspace:*",
		"@dead-certain/kb-tools": "workspace:*",
		"@dead-certain/ui": "workspace:*",
		"@playwright/test": "1.65.0",
		"fast-check": "4.10.2",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
