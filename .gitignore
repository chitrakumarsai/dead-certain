# Dependencies and build output
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
# Screenshots made by e2e/evidence.spec.ts; CI uploads them as an artifact.
evidence/
# The same screenshots downloaded with `gh run download <id> -n screenshots`.
/390/
/768/
/1280/
coverage/

# Python (managed with uv)
.venv/
__pycache__/

# Secrets and local state
.env
.env.*
.claude/settings.local.json
.DS_Store

# Markdown stays out of git by owner's instruction (planning docs in docs/ and stray notes).
# Exceptions: files the agents, the hackathon rules or the running apps need.
*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/.kiro/**
!/.claude/**
# The line above re-includes everything under .claude; keep machine-local settings out.
/.claude/settings.local.json
!/apps/*/rulebook/**
!/apps/*/kb/**
!/docs/kb-format.md
# Kiro's session log, versioned so the submission write-up has a public record.
!/docs/kiro-log.md
