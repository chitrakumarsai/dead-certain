# Dependencies and build output
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
coverage/

# Python (managed with uv)
.venv/
__pycache__/

# Secrets and local state
.env
.env.*
.claude/settings.local.json
.DS_Store

# Markdown stays out of git by owner's instruction (planning docs in docs/ and stray notes).
# Exceptions: files the agents, the hackathon rules or the running apps need.
*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/.kiro/**
!/.claude/**
!/apps/*/rulebook/**
!/apps/*/kb/**
!/docs/kb-format.md
